 "changes": [
  "recoded IT-AO Aosta -> IT-23 Valle d'Aosta / Vallée d'Aoste (old code kept as alias)",
  "recoded IT-GA Gallura Nord-Est Sardegna -> IT-GALLURA_NORD_EST_SARDEGNA Gallura Nord-Est Sardegna (old code kept as alias)",
  "recoded IT-OG Ogliastra -> IT-OGLIASTRA Ogliastra (old code kept as alias)",
  "recoded IT-SD Sulcis Iglesiente -> IT-SULCIS_IGLESIENTE Sulcis Iglesiente (old code kept as alias)",
  "merged IT-SU Sud Sardegna -> IT-SULCIS_IGLESIENTE Sulcis Iglesiente (old code kept as alias)",
  "recoded IT-VS Medio Campidano -> IT-MEDIO_CAMPIDANO Medio Campidano (old code kept as alias)"
 ],
